<!DOCTYPE html>
<html lang="pt-br">
<%- include('partials/head', { title: 'Meu Perfil' }) %>
<body>
    <%- include('partials/navbar') %>

    <section class="section-padding" style="padding-top: 120px;">
        <div class="container">
            <div class="profile-header animate-up" style="background: var(--gray-50); padding: 3rem; border-radius: var(--radius-xl); border: 1px solid var(--gray-200); margin-bottom: 4rem; text-align: center; position: relative;">
                <div style="position: absolute; top: 1.5rem; right: 1.5rem;">
                    <button id="btn-edit-profile" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem;">
                        <i data-lucide="edit-3" style="width: 16px; height: 16px;"></i>
                        Editar Perfil
                    </button>
                </div>

                <div class="user-avatar" style="width: 120px; height: 120px; border-radius: 50%; margin: 0 auto 1.5rem; overflow: hidden; display: flex; align-items: center; justify-content: center; background: var(--emerald-500); color: white; border: 4px solid white; box-shadow: var(--shadow-md);">
                    <% if (user.profilePic) { %>
                        <img src="<%= user.profilePic %>" alt="Foto de <%= user.name %>" style="width: 100%; height: 100%; object-fit: cover;">
                    <% } else { %>
                        <span style="font-size: 3rem; font-weight: 800;"><%= user.name.charAt(0).toUpperCase() %></span>
                    <% } %>
                </div>
                <h2><%= user.name %></h2>
                <p style="color: var(--gray-600); margin-bottom: 1rem;"><%= user.email %></p>
                <% if (user.bio) { %>
                    <p style="max-width: 600px; margin: 0 auto; color: var(--navy-800); line-height: 1.6;"><%= user.bio %></p>
                <% } else { %>
                    <p style="color: var(--gray-600); font-style: italic; font-size: 0.9rem;">Nenhuma bio adicionada.</p>
                <% } %>
            </div>

            <!-- MODAL DE EDIÇÃO -->
            <div id="modal-edit-profile" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 2000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
                <div class="auth-card" style="position: relative; max-width: 500px; animation: fadeInUp 0.4s ease;">
                    <button id="btn-close-modal" style="position: absolute; top: 1rem; right: 1rem; background: none; border: none; cursor: pointer; color: var(--gray-600);">
                        <i data-lucide="x"></i>
                    </button>
                    
                    <div class="auth-header">
                        <h2>Editar Perfil</h2>
                        <p>Atualize sua foto e informações</p>
                    </div>

                    <form id="form-edit-profile" class="auth-form">
                        <div class="form-group" style="text-align: center;">
                            <label>Foto de Perfil</label>
                            <div id="profile-pic-preview" style="width: 100px; height: 100px; border-radius: 50%; background: var(--gray-100); margin: 0 auto 1rem; overflow: hidden; display: flex; align-items: center; justify-content: center; border: 2px dashed var(--gray-300); cursor: pointer; position: relative;">
                                <% if (user.profilePic) { %>
                                    <img src="<%= user.profilePic %>" style="width: 100%; height: 100%; object-fit: cover;">
                                <% } else { %>
                                    <i data-lucide="camera" style="color: var(--gray-400);"></i>
                                <% } %>
                                <input type="file" id="input-profile-pic" accept="image/*" style="position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer;">
                            </div>
                            <span style="font-size: 0.75rem; color: var(--gray-600);">Clique para alterar</span>
                        </div>

                        <div class="form-group">
                            <label for="bio">Sua Bio</label>
                            <textarea id="bio" name="bio" rows="4" style="padding: 0.75rem 1rem; border-radius: var(--radius-md); border: 1px solid var(--gray-200); font-family: inherit; resize: none;" placeholder="Conte um pouco sobre você..."><%= user.bio || '' %></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary" id="btn-save-profile">
                            Salvar Alterações
                        </button>
                    </form>
                </div>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const modal = document.getElementById('modal-edit-profile');
                    const btnEdit = document.getElementById('btn-edit-profile');
                    const btnClose = document.getElementById('btn-close-modal');
                    const form = document.getElementById('form-edit-profile');
                    const inputPic = document.getElementById('input-profile-pic');
                    const picPreview = document.getElementById('profile-pic-preview');
                    let base64Pic = '<%= user.profilePic || "" %>';

                    // Abrir/Fechar Modal
                    btnEdit.addEventListener('click', () => modal.style.display = 'flex');
                    btnClose.addEventListener('click', () => modal.style.display = 'none');
                    window.addEventListener('click', (e) => { if(e.target === modal) modal.style.display = 'none'; });

                    // Preview e Redimensionamento de Imagem
                    inputPic.addEventListener('change', function(e) {
                        const file = e.target.files[0];
                        if (!file) return;

                        const reader = new FileReader();
                        reader.onload = function(event) {
                            const img = new Image();
                            img.onload = function() {
                                const canvas = document.createElement('canvas');
                                const MAX_WIDTH = 300;
                                const MAX_HEIGHT = 300;
                                let width = img.width;
                                let height = img.height;

                                if (width > height) {
                                    if (width > MAX_WIDTH) {
                                        height *= MAX_WIDTH / width;
                                        width = MAX_WIDTH;
                                    }
                                } else {
                                    if (height > MAX_HEIGHT) {
                                        width *= MAX_HEIGHT / height;
                                        height = MAX_HEIGHT;
                                    }
                                }

                                canvas.width = width;
                                canvas.height = height;
                                const ctx = canvas.getContext('2d');
                                ctx.drawImage(img, 0, 0, width, height);
                                
                                base64Pic = canvas.toDataURL('image/jpeg', 0.7);
                                picPreview.innerHTML = `<img src="${base64Pic}" style="width: 100%; height: 100%; object-fit: cover;">`;
                            };
                            img.src = event.target.result;
                        };
                        reader.readAsDataURL(file);
                    });

                    // Salvar Perfil
                    form.addEventListener('submit', async (e) => {
                        e.preventDefault();
                        const btnSave = document.getElementById('btn-save-profile');
                        const bio = document.getElementById('bio').value;

                        btnSave.disabled = true;
                        btnSave.innerText = 'Salvando...';

                        try {
                            const response = await fetch('/perfil/update', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ bio, profilePic: base64Pic })
                            });

                            if (response.ok) {
                                location.reload();
                            } else {
                                alert('Erro ao salvar perfil.');
                                btnSave.disabled = false;
                                btnSave.innerText = 'Salvar Alterações';
                            }
                        } catch (error) {
                            console.error('Erro:', error);
                            alert('Erro de conexão.');
                            btnSave.disabled = false;
                            btnSave.innerText = 'Salvar Alterações';
                        }
                    });
                });
            </script>

            <div class="my-agenda animate-up" style="animation-delay: 0.2s; margin-bottom: 4rem;">
                <h3 style="font-size: 2rem; margin-bottom: 2rem; color: var(--navy-900); border-bottom: 2px solid var(--emerald-500); display: inline-block; padding-bottom: 0.5rem;">Minha Agenda</h3>
                
                <div class="events-timeline">
                    <% if (locals.joinedEvents && joinedEvents.length > 0) { %>
                        <% joinedEvents.forEach(function(event) { %>
                            <div class="event-card">
                                <div class="event-date">
                                    <span class="day"><%= event.date.split('-')[2] %></span>
                                    <span class="month"><%= event.date.split('-')[1] %></span>
                                </div>
                                <div class="event-details">
                                    <h3><%= event.title %></h3>
                                    <div class="event-meta">
                                        <span><i data-lucide="map-pin"></i> <%= event.location %></span>
                                        <span><i data-lucide="clock"></i> <%= event.time %></span>
                                    </div>
                                </div>
                                <div style="display: flex; gap: 1rem; align-items: center;">
                                    <a href="/evento?id=<%= event._id %>" class="btn btn-outline">Ver</a>
                                    <form action="/evento/cancelar" method="POST" style="margin: 0;">
                                        <input type="hidden" name="eventId" value="<%= event._id %>">
                                        <button type="submit" class="btn" style="background: #fee2e2; color: #ef4444; padding: 0.5rem; width: 40px; height: 40px;" title="Remover da Agenda">
                                            <i data-lucide="trash-2" style="width: 18px; height: 18px;"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div style="text-align: center; padding: 4rem; background: var(--gray-50); border-radius: var(--radius-lg); border: 2px dashed var(--gray-200);">
                            <p style="opacity: 0.7; font-size: 1.1rem;">Você ainda não se inscreveu em nenhum evento.</p>
                            <a href="/eventos" class="btn btn-primary" style="margin-top: 1.5rem;">Explorar Eventos</a>
                        </div>
                    <% } %>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem;">
                <div class="animate-up" style="animation-delay: 0.3s;">
                    <h3 style="font-size: 1.75rem; margin-bottom: 2rem; color: var(--navy-900); border-bottom: 2px solid var(--emerald-500); display: inline-block; padding-bottom: 0.5rem;">Meus Projetos</h3>
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <% if (locals.myProjects && myProjects.length > 0) { %>
                            <% myProjects.forEach(function(project) { %>
                                <a href="/projeto?id=<%= project.slug %>" style="display: flex; align-items: center; gap: 1rem; padding: 1rem; background: white; border-radius: var(--radius-md); border: 1px solid var(--gray-100); text-decoration: none; transition: var(--transition-base);">
                                    <img src="<%= project.image %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: var(--radius-sm);">
                                    <div>
                                        <h4 style="color: var(--navy-900); margin: 0;"><%= project.title %></h4>
                                        <span style="font-size: 0.8rem; color: var(--emerald-600);"><%= project.category %></span>
                                    </div>
                                </a>
                            <% }); %>
                        <% } else { %>
                            <div style="padding: 2rem; background: var(--gray-50); border-radius: var(--radius-md); text-align: center; border: 1px dashed var(--gray-200);">
                                <p style="color: var(--gray-600); font-size: 0.9rem;">Você ainda não criou nenhum projeto.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="animate-up" style="animation-delay: 0.4s;">
                    <h3 style="font-size: 1.75rem; margin-bottom: 2rem; color: var(--navy-900); border-bottom: 2px solid var(--emerald-500); display: inline-block; padding-bottom: 0.5rem;">Meus Eventos</h3>
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <% if (locals.myEvents && myEvents.length > 0) { %>
                            <% myEvents.forEach(function(event) { %>
                                <a href="/eventos" style="display: flex; align-items: center; gap: 1rem; padding: 1rem; background: white; border-radius: var(--radius-md); border: 1px solid var(--gray-100); text-decoration: none; transition: var(--transition-base);">
                                    <div style="width: 60px; height: 60px; background: var(--navy-900); color: white; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm);">
                                        <i data-lucide="calendar" style="width: 24px; height: 24px;"></i>
                                    </div>
                                    <div>
                                        <h4 style="color: var(--navy-900); margin: 0;"><%= event.title %></h4>
                                        <span style="font-size: 0.8rem; color: var(--gray-600);"><%= event.date %></span>
                                    </div>
                                </a>
                            <% }); %>
                        <% } else { %>
                            <div style="padding: 2rem; background: var(--gray-50); border-radius: var(--radius-md); text-align: center; border: 1px dashed var(--gray-200);">
                                <p style="color: var(--gray-600); font-size: 0.9rem;">Você ainda não criou nenhum evento.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>
</body>
</html>
