<!DOCTYPE html>
<html lang="pt-br">
<%- include('partials/head', { title: 'Projeto' }) %>
<body>
    <%- include('partials/navbar') %>

    <main id="main-content">
        <!-- Project Hero -->
        <section class="project-hero section-padding">
            <div class="container">
                <div class="project-header animate-up">
                    <div style="margin-bottom: 1rem;">
                        <span id="project-category" class="project-tag"><%= post.category %></span>
                    </div>
                    <h1 id="project-title"><%= post.title %></h1>
                    <p id="project-description" class="lead-text"><%= post.description %></p>
                </div>
                
                <div id="project-image" class="project-hero-img animate-up" style="--bg-url: url('<%= post.image %>'); background-image: var(--bg-url); animation-delay: 0.2s;"></div>
            </div>
        </section>

        <!-- Project Content -->
        <section class="project-details section-padding">
            <div class="container project-details-grid">
                <div class="main-content animate-up">
                    <h2>Sobre o Projeto</h2>
                    <div id="project-long-description" style="font-size: 1.15rem; line-height: 1.8; white-space: pre-line;">
                        <%= post.longDescription || 'Nenhuma descrição detalhada fornecida.' %>
                    </div>

                    <% if (post.authorName) { %>
                        <div style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--gray-100); color: var(--gray-600); font-size: 0.95rem; font-style: italic; display: flex; justify-content: space-between; align-items: center;">
                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                                <div class="author-avatar" style="width: 40px; height: 40px; border-radius: 50%; overflow: hidden; background: var(--emerald-500); display: flex; align-items: center; justify-content: center; color: white; font-style: normal; font-weight: 700; flex-shrink: 0;">
                                    <% if (locals.author && author.profilePic) { %>
                                        <img src="<%= author.profilePic %>" alt="<%= post.authorName %>" style="width: 100%; height: 100%; object-fit: cover;">
                                    <% } else { %>
                                        <%= post.authorName.charAt(0).toUpperCase() %>
                                    <% } %>
                                </div>
                                <span>Postado por: <strong style="color: var(--navy-900); font-style: normal;"><%= post.authorName %></strong></span>
                            </div>
                            
                            <div class="like-container" style="display: flex; align-items: center; gap: 1rem;">
                                <button class="btn-like-ajax <%= locals.user && post.likes && post.likes.some(id => id && id.toString() === user._id.toString()) ? 'active' : '' %>" data-id="<%= post._id %>" aria-label="Curtir este projeto">
                                    <i data-lucide="heart" class="heart-icon"></i>
                                    <span class="like-count" id="likeCountText"><%= post.likes ? post.likes.length : 0 %> <%= (post.likes ? post.likes.length : 0) === 1 ? 'Curtida' : 'Curtidas' %></span>
                                </button>
                                
                                <button id="btn-share-project" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; border-color: var(--gray-200); color: var(--gray-600);">
                                    <i data-lucide="share-2" style="width: 16px; height: 16px;"></i>
                                    Compartilhar
                                </button>
                            </div>
                        </div>
                    <% } else { %>
                        <div style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--gray-100); display: flex; justify-content: flex-end;">
                            <div class="like-container" style="display: flex; align-items: center; gap: 1rem;">
                                <button class="btn-like-ajax <%= locals.user && post.likes && post.likes.some(id => id && id.toString() === user._id.toString()) ? 'active' : '' %>" data-id="<%= post._id %>" aria-label="Curtir este projeto">
                                    <i data-lucide="heart" class="heart-icon"></i>
                                    <span class="like-count" id="likeCountText"><%= post.likes ? post.likes.length : 0 %> <%= (post.likes ? post.likes.length : 0) === 1 ? 'Curtida' : 'Curtidas' %></span>
                                </button>

                                <button id="btn-share-project-no-author" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; border-color: var(--gray-200); color: var(--gray-600);">
                                    <i data-lucide="share-2" style="width: 16px; height: 16px;"></i>
                                    Compartilhar
                                </button>
                            </div>
                        </div>
                    <% } %>

                    <script>
                        document.addEventListener('DOMContentLoaded', () => {
                            const modal = document.getElementById('modal-share');
                            const btnShare = document.getElementById('btn-share-project');
                            const btnShareNoAuthor = document.getElementById('btn-share-project-no-author');
                            const btnClose = document.getElementById('btn-close-share');
                            const linkInput = document.getElementById('share-link-input');
                            const btnCopy = document.getElementById('btn-copy-link');

                            // Configurar link atual
                            linkInput.value = window.location.href;

                            const openModal = () => {
                                modal.style.display = 'flex';
                                document.body.style.overflow = 'hidden';
                            };

                            const closeModal = () => {
                                modal.style.display = 'none';
                                document.body.style.overflow = 'auto';
                            };

                            if (btnShare) btnShare.addEventListener('click', openModal);
                            if (btnShareNoAuthor) btnShareNoAuthor.addEventListener('click', openModal);
                            if (btnClose) btnClose.addEventListener('click', closeModal);
                            window.addEventListener('click', (e) => { if(e.target === modal) closeModal(); });

                            // Copiar Link
                            btnCopy.addEventListener('click', () => {
                                linkInput.select();
                                document.execCommand('copy');
                                btnCopy.innerText = 'Copiado!';
                                btnCopy.style.background = 'var(--navy-900)';
                                setTimeout(() => {
                                    btnCopy.innerText = 'Copiar';
                                    btnCopy.style.background = 'var(--emerald-500)';
                                }, 2000);
                            });

                            // Encaminhar para Amigos
                            document.querySelectorAll('.btn-forward-project').forEach(btn => {
                                btn.addEventListener('click', async () => {
                                    const friendId = btn.getAttribute('data-friend-id');
                                    const projectTitle = document.getElementById('project-title').innerText;
                                    const projectLink = window.location.href;
                                    const content = `Olá! Veja este projeto incrível no Impacta Mais: *${projectTitle}*\nLink: ${projectLink}`;

                                    btn.disabled = true;
                                    btn.innerText = 'Enviando...';

                                    try {
                                        const response = await fetch('/mensagens/send', {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({ receiverId: friendId, content })
                                        });

                                        if (response.ok) {
                                            btn.innerText = 'Enviado!';
                                            btn.style.background = 'var(--emerald-50) ';
                                            btn.style.color = 'var(--emerald-600)';
                                            btn.style.borderColor = 'var(--emerald-200)';
                                        } else {
                                            btn.disabled = false;
                                            btn.innerText = 'Erro';
                                        }
                                    } catch (err) {
                                        console.error(err);
                                        btn.disabled = false;
                                        btn.innerText = 'Erro';
                                    }
                                });
                            });
                        });
                    </script>
                    

                    <!-- Comments Section -->
                    <div class="comments-section" style="margin-top: 4rem; padding-top: 3rem; border-top: 1px solid var(--gray-200);">
                        <h2 style="font-size: 1.75rem; margin-bottom: 2rem;">Comentários</h2>

                        <% if (locals.user) { %>
                            <form action="/projeto/comentar" method="POST" class="comment-form" style="margin-bottom: 3rem;">
                                <input type="hidden" name="projectId" value="<%= post._id %>">
                                <div class="form-group">
                                    <label for="content">Deixe sua mensagem:</label>
                                    <textarea name="content" id="content" rows="4" placeholder="O que você achou deste projeto?" required style="width: 100%; padding: 1rem; border-radius: var(--radius-md); border: 1px solid var(--gray-200); font-family: inherit; resize: vertical;"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">Enviar Comentário</button>
                            </form>
                        <% } else { %>
                            <div style="background: var(--gray-50); padding: 1.5rem; border-radius: var(--radius-md); text-align: center; margin-bottom: 3rem;">
                                <p>Você precisa estar <a href="/login" style="color: var(--emerald-500); font-weight: 600;">logado</a> para comentar.</p>
                            </div>
                        <% } %>

                        <div class="comments-list" style="display: flex; flex-direction: column; gap: 2rem;">
                            <% if (post.comments && post.comments.length > 0) { %>
                                <% post.comments.reverse().forEach(comment => { %>
                                    <div class="comment-item" style="background: var(--white); padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--gray-100); box-shadow: var(--shadow-sm);">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                            <span style="font-weight: 700; color: var(--navy-900); display: flex; align-items: center; gap: 0.5rem;">
                                                <i data-lucide="user" style="width: 16px; height: 16px;"></i>
                                                <%= comment.userName %>
                                            </span>
                                            <span style="font-size: 0.85rem; color: var(--gray-600);">
                                                <%= new Date(comment.createdAt).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: 'long', year: 'numeric' }) %>
                                            </span>
                                        </div>
                                        <p style="color: var(--gray-600); line-height: 1.6;"><%= comment.content %></p>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p style="text-align: center; opacity: 0.7; margin: 2rem 0;">Seja o primeiro a comentar!</p>
                            <% } %>
                        </div>
                    </div>
                </div>

                <aside class="sidebar animate-up" style="animation-delay: 0.3s;">
                    <div class="sidebar-card" style="margin-bottom: 2rem;">
                        <h3>Dados do Projeto</h3>
                        <div class="stat-item">
                            <i data-lucide="target" class="stat-icon"></i>
                            <div>
                                <span class="stat-label">Meta de Impacto</span>
                                <span class="stat-value"><%= post.impact || 'N/A' %></span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <i data-lucide="users" class="stat-icon"></i>
                            <div>
                                <span class="stat-label">Equipe</span>
                                <span class="stat-value"><%= post.volunteers || 'N/A' %></span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <i data-lucide="activity" class="stat-icon"></i>
                            <div>
                                <span class="stat-label">Status</span>
                                <span class="stat-value" style="color: var(--emerald-600);"><%= post.status || 'Ativo' %></span>
                            </div>
                        </div>
                    </div>

                    <div class="sidebar-card" style="margin-top: 2rem; background: var(--navy-900); color: var(--white);">
                        <h3>Compartilhe</h3>
                        <p style="font-size: 0.9rem; opacity: 0.8; margin-bottom: 1.5rem;">Ajude-nos a levar esta mensagem para mais pessoas.</p>
                        <div class="social-links" style="display: flex; gap: 1rem;">
                            <a href="#" aria-label="Compartilhar no Twitter"><i data-lucide="twitter"></i></a>
                            <a href="#" aria-label="Compartilhar no Facebook"><i data-lucide="facebook"></i></a>
                            <a href="#" aria-label="Compartilhar no LinkedIn"><i data-lucide="linkedin"></i></a>
                        </div>
                    </div>
                </aside>
            </div>
        </section>
    </main>

    <!-- MODAL COMPARTILHAR -->
    <div id="modal-share" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.8); z-index: 10000; backdrop-filter: blur(8px);">
        <div class="auth-card" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); max-width: 450px; width: 90%; animation: fadeInUp 0.4s ease; box-shadow: 0 30px 60px rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); margin: 0; background: white; border-radius: var(--radius-lg); padding: 2rem;">
            <button id="btn-close-share" style="position: absolute; top: 1.25rem; right: 1.25rem; background: var(--gray-100); border: none; cursor: pointer; color: var(--gray-600); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.2s; z-index: 10;">
                <i data-lucide="x" style="width: 18px; height: 18px;"></i>
            </button>
            
            <div class="auth-header" style="margin-bottom: 1.5rem; text-align: center;">
                <h2 style="font-size: 1.5rem; color: var(--navy-900); margin: 0;">Compartilhar</h2>
                <p style="color: var(--gray-500); margin-top: 0.5rem;">Escolha como espalhar essa iniciativa</p>
            </div>

            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                <!-- Copiar Link -->
                <div style="background: var(--gray-50); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--gray-200);">
                    <label style="font-size: 0.75rem; font-weight: 700; color: var(--gray-400); text-transform: uppercase; margin-bottom: 0.75rem; display: block;">Link do Projeto</label>
                    <div class="share-link-group">
                        <input type="text" id="share-link-input" readonly value="" style="flex: 1; padding: 0.75rem; border: 1px solid var(--gray-200); border-radius: var(--radius-sm); font-size: 0.85rem; background: white; outline: none; width: 100%;">
                        <button id="btn-copy-link" class="btn btn-primary" style="padding: 0 1.25rem; font-size: 0.85rem; font-weight: 600; white-space: nowrap;">Copiar</button>
                    </div>
                </div>

                <!-- Encaminhar para Amigos -->
                <div>
                    <h4 style="font-size: 0.9rem; font-weight: 700; margin-bottom: 1rem; color: var(--navy-900); display: flex; align-items: center; gap: 0.5rem;">
                        <i data-lucide="users" style="width: 18px; height: 18px; color: var(--emerald-500);"></i>
                        Encaminhar para Amigos
                    </h4>
                    <div class="friends-scroll-area" style="max-height: 240px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.5rem; padding-right: 4px;">
                        <% if (locals.user && locals.friendsList && friendsList.length > 0) { %>
                            <% friendsList.forEach(friend => { %>
                                <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem; background: white; border: 1px solid var(--gray-100); border-radius: var(--radius-md); transition: all 0.2s;">
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <div style="width: 38px; height: 38px; border-radius: 50%; overflow: hidden; background: var(--emerald-500); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.9rem; font-weight: 700;">
                                                            <% if (friend.profilePic) { %>
                                                                <img src="<%= friend.profilePic %>" style="width: 100%; height: 100%; object-fit: cover;">
                                                            <% } else { %>
                                                                <%= friend.name.charAt(0).toUpperCase() %>
                                                            <% } %>
                                        </div>
                                        <span style="font-size: 0.9rem; font-weight: 600; color: var(--navy-900);"><%= friend.name %></span>
                                    </div>
                                    <button class="btn btn-outline btn-forward-project" data-friend-id="<%= friend._id %>" style="padding: 0.5rem 0.75rem; font-size: 0.75rem; border-radius: 100px;">Encaminhar</button>
                                </div>
                            <% }) %>
                        <% } else if (!locals.user) { %>
                            <div style="text-align: center; padding: 1.5rem; background: var(--gray-50); border-radius: var(--radius-md); border: 1px dashed var(--gray-200);">
                                <p style="font-size: 0.85rem; color: var(--gray-500);">Faça <a href="/login" style="color: var(--emerald-600); font-weight: 600;">login</a> para compartilhar.</p>
                            </div>
                        <% } else { %>
                            <div style="text-align: center; padding: 1.5rem; background: var(--gray-50); border-radius: var(--radius-md); border: 1px dashed var(--gray-200);">
                                <p style="font-size: 0.85rem; color: var(--gray-500);">Você ainda não tem amigos.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
