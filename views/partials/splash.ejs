<div id="splash-screen">
    <div class="splash-content">
        <div class="brand-joining">
            <span class="part-impacta">Impacta</span>
            <span class="part-mais">Mais</span>
        </div>
        <div class="loader-line"></div>
    </div>
</div>

<style>
    #splash-screen {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        transition: opacity 0.6s ease, visibility 0.6s;
    }

    .splash-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }

    .brand-joining {
        font-size: 3.5rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        letter-spacing: -1px;
    }

    .part-impacta {
        color: var(--emerald-500);
        transform: translateX(-50px);
        opacity: 0;
        animation: joinLeft 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    .part-mais {
        color: var(--navy-900);
        transform: translateX(50px);
        opacity: 0;
        animation: joinRight 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    .loader-line {
        width: 0;
        height: 3px;
        background: var(--emerald-500);
        border-radius: 10px;
        animation: growLine 1.5s ease-in-out 0.8s forwards;
    }

    @keyframes joinLeft {
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @keyframes joinRight {
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @keyframes growLine {
        from { width: 0; }
        to { width: 150px; }
    }

    .splash-hidden {
        opacity: 0;
        visibility: hidden;
        transform: scale(1.05);
    }
</style>

<script>
    (function() {
        const splashShown = sessionStorage.getItem('splash_shown');
        const splash = document.getElementById('splash-screen');

        if (splashShown) {
            splash.remove();
            return;
        }

        window.addEventListener('load', () => {
            setTimeout(() => {
                splash.classList.add('splash-hidden');
                sessionStorage.setItem('splash_shown', 'true');
                
                setTimeout(() => {
                    splash.remove();
                }, 600);
            }, 2500);
        });
    })();
</script>
