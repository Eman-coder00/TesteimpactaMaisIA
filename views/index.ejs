<!DOCTYPE html>
<html lang="pt-br">
<%- include('partials/head', { title: 'Início' }) %>
<body>
    <%- include('partials/splash') %>
    <%- include('partials/navbar') %>

    <main id="main-content">
        <!-- Hero Section -->
        <section id="hero" class="hero">
            <div class="container hero-content animate-up">
                <h1>Conectando Propósitos, <br> Ampliando Impactos</h1>
                <p>Transformamos boas intenções em ações reais. Conheça projetos que estão mudando o mundo e descubra como você pode contribuir.</p>
                <div class="hero-btns">
                    <a href="#projetos" class="btn btn-primary">Explorar Projetos</a>
                    <a href="#eventos" class="btn btn-outline" style="margin-left: 1rem;">Ver Agenda</a>
                </div>
            </div>
        </section>

        <!-- Projects Directory -->
        <section id="projetos" class="section-padding">
            <div class="container">
                <div class="section-title animate-up" style="display: flex; justify-content: space-between; align-items: flex-end; text-align: left; margin-bottom: 4rem; flex-wrap: wrap; gap: 2rem;">
                    <div style="max-width: 600px;">
                        <h2>Causas que Apoiamos</h2>
                        <p>Explore as frentes de atuação do Impacta Mais e encontre a causa que mais ressoa com o seu propósito.</p>
                    </div>
                    
                    <div class="filter-wrapper" style="display: flex; align-items: center; gap: 1.5rem; background: var(--gray-50); padding: 0.5rem 1rem; border-radius: var(--radius-md); border: 1px solid var(--gray-200); flex-wrap: wrap;">
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <i data-lucide="tag" style="width: 18px; height: 18px; color: var(--gray-600);"></i>
                            <label for="filterCategory" style="font-size: 0.9rem; font-weight: 600; color: var(--navy-800);">Categoria:</label>
                            <select id="filterCategory" onchange="updateFilters()" style="background: none; border: none; font-family: inherit; font-size: 0.9rem; font-weight: 700; color: var(--emerald-600); cursor: pointer; outline: none;">
                                <option value="Todos" <%= locals.currentCategory === 'Todos' ? 'selected' : '' %>>Todos</option>
                                <option value="Educação" <%= locals.currentCategory === 'Educação' ? 'selected' : '' %>>Educação</option>
                                <option value="Meio Ambiente" <%= locals.currentCategory === 'Meio Ambiente' ? 'selected' : '' %>>Meio Ambiente</option>
                                <option value="Saúde" <%= locals.currentCategory === 'Saúde' ? 'selected' : '' %>>Saúde</option>
                                <option value="Social" <%= locals.currentCategory === 'Social' ? 'selected' : '' %>>Social</option>
                                <option value="Tecnologia" <%= locals.currentCategory === 'Tecnologia' ? 'selected' : '' %>>Tecnologia</option>
                            </select>
                        </div>

                        <div style="width: 1px; height: 20px; background: var(--gray-200); display: block;"></div>

                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <i data-lucide="sliders-horizontal" style="width: 18px; height: 18px; color: var(--gray-600);"></i>
                            <label for="sortProjects" style="font-size: 0.9rem; font-weight: 600; color: var(--navy-800);">Ordenar por:</label>
                            <select id="sortProjects" onchange="updateFilters()" style="background: none; border: none; font-family: inherit; font-size: 0.9rem; font-weight: 700; color: var(--emerald-600); cursor: pointer; outline: none;">
                                <option value="latest" <%= locals.currentSort === 'latest' ? 'selected' : '' %>>Mais Recentes</option>
                                <option value="likes" <%= locals.currentSort === 'likes' ? 'selected' : '' %>>Mais Curtidos</option>
                            </select>
                        </div>
                    </div>

                    <script>
                        function updateFilters() {
                            const sort = document.getElementById('sortProjects').value;
                            const category = document.getElementById('filterCategory').value;
                            window.location.href = `/?sort=${sort}&category=${encodeURIComponent(category)}#projetos`;
                        }
                    </script>
                </div>
                
                <div class="projects-grid">
                    <% if (locals.posts && Array.isArray(posts) && posts.length > 0) { %>
                        <% posts.forEach(function(post, index) { %>
                            <div class="project-card animate-up" onclick="if(!event.target.closest('.btn-like-ajax')) window.location.href='/projeto?id=<%= post.slug %>'" style="--delay: <%= (index + 1) * 0.1 %>s; animation-delay: var(--delay); cursor: pointer;">
                                <div class="project-img" style="background-image: url('<%= post.image %>');"></div>
                                <div class="project-info">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                                        <span class="project-tag"><%= post.category %></span>
                                        <div class="like-container">
                                            <button class="btn-like-ajax <%= locals.user && post.likes && post.likes.some(id => id && id.toString() === user._id.toString()) ? 'active' : '' %>" data-id="<%= post._id %>" aria-label="Curtir este projeto">
                                                <i data-lucide="heart" class="heart-icon"></i>
                                                <span class="like-count"><%= post.likes ? post.likes.length : 0 %></span>
                                            </button>
                                        </div>
                                    </div>
                                    <h3><%= post.title %></h3>
                                    <p><%= post.description %></p>
                                    <a href="/projeto?id=<%= post.slug %>" class="btn btn-outline" style="width: 100%;">Saiba Mais</a>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p style="grid-column: 1/-1; text-align: center; opacity: 0.7;">Nenhum projeto encontrado no momento.</p>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- Events Section -->
        <section id="eventos" class="events-section section-padding">
            <div class="container">
                <div class="section-title animate-up">
                    <h2>Próximos Eventos</h2>
                    <p>Participe das nossas atividades presenciais e online. O impacto começa com a sua presença.</p>
                </div>

                <div class="events-timeline">
                    <% if (locals.events && events.length > 0) { %>
                        <% events.forEach(function(event, index) { %>
                            <div class="event-card animate-up" style="--delay: <%= index * 0.1 %>s; animation-delay: var(--delay);">
                                <div class="event-date">
                                    <% 
                                        const dateParts = event.date ? event.date.split('-') : ['00', '00', '00'];
                                        const day = dateParts[2] || '00';
                                        const months = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];
                                        const month = months[parseInt(dateParts[1]) - 1] || '???';
                                    %>
                                    <span class="day text-navy-900"><%= day %></span>
                                    <span class="month text-navy-600"><%= month %></span>
                                </div>
                                <div class="event-details">
                                    <h3><%= event.title %></h3>
                                    <div class="event-meta">
                                        <span><i data-lucide="map-pin" aria-hidden="true" style="width: 14px; height: 14px; vertical-align: middle;"></i> <%= event.location %></span>
                                        <span><i data-lucide="clock" aria-hidden="true" style="width: 14px; height: 14px; vertical-align: middle;"></i> <%= event.time %></span>
                                        <span style="color: var(--emerald-600); font-weight: 600;"><i data-lucide="users" aria-hidden="true" style="width: 14px; height: 14px; vertical-align: middle;"></i> <%= event.participants ? event.participants.length : 0 %></span>
                                    </div>
                                </div>
                                <a href="/evento?id=<%= event._id %>" class="btn btn-primary">Ver Detalhes</a>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p style="text-align: center; opacity: 0.7; grid-column: 1/-1;">Fique ligado! Novos eventos em breve.</p>
                    <% } %>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
